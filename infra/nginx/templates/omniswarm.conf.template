# Rendered by the nginx image entrypoint into /etc/nginx/conf.d/omniswarm.conf.
# Only ${OMNI_*} names are substituted (NGINX_ENVSUBST_FILTER=^OMNI_):
#   OMNI_DOMAIN          app hostname            (omniswarm.example)
#   OMNI_REPORTS_DOMAIN  reports hostname        (reports.omniswarm.example)
#   OMNI_APP_ORIGIN      https origin of the app
#   OMNI_REPORTS_ORIGIN  https origin of reports
# One certificate (cert name = OMNI_DOMAIN) covers both hostnames.
# The local stack does not use this file. It mounts templates-http/ instead.

# Upstreams are resolved per request (proxy_pass with a variable) through
# Docker's DNS (resolver in nginx.conf), so `--scale api=N` and rolling
# restarts change the replica set without a reload. Each request gets the
# current address list (rotated, so load spreads) and retries within it
# (proxy_next_upstream). A shared `upstream { server api resolve; }` group was
# tried and dropped: when a re-resolve replaced its peers while a request was
# connecting to a departed replica, nginx answered "no live upstreams" (502)
# with healthy replicas left (infra/check/bring-up.sh rolling-restart test).

map $host $omni_https_origin {
  ${OMNI_REPORTS_DOMAIN} ${OMNI_REPORTS_ORIGIN};
  default                ${OMNI_APP_ORIGIN};
}

# :80 serves ACME http-01 challenges and redirects everything else to https.
server {
  listen 80 default_server;
  server_name _;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  include /etc/nginx/snippets/nginx-health.conf;

  location / {
    return 301 $omni_https_origin$request_uri;
  }
}

# Unknown names on :443 get no certificate and no content.
server {
  listen 443 ssl default_server;
  server_name _;
  ssl_reject_handshake on;
}

# App origin: Next.js web app at /, intake API at /api/.
server {
  listen 443 ssl;
  http2 on;
  server_name ${OMNI_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${OMNI_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${OMNI_DOMAIN}/privkey.pem;
  include /etc/nginx/snippets/tls.conf;

  include /etc/nginx/snippets/headers-common.conf;
  include /etc/nginx/snippets/hsts.conf;
  # Framing and base-uri only; the web app may send its own script policy,
  # and the browser enforces both.
  add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  add_header X-Frame-Options "DENY" always;

  include /etc/nginx/snippets/app-locations.conf;
}

# Reports origin: published report folders, read-only, separate origin.
server {
  listen 443 ssl;
  http2 on;
  server_name ${OMNI_REPORTS_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${OMNI_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${OMNI_DOMAIN}/privkey.pem;
  include /etc/nginx/snippets/tls.conf;

  root /srv/reports;
  autoindex off;
  client_max_body_size 1k;

  include /etc/nginx/snippets/headers-common.conf;
  include /etc/nginx/snippets/hsts.conf;
  # Reports quote untrusted target text. Each report page also carries its own
  # <meta> CSP that pins scripts to a per-page nonce
  # (engine/scripts/generate-html-report.mjs); browsers enforce both policies, so the
  # inline allowances here only admit what that nonce admits. frame-ancestors
  # and sandbox work only as a header, which is why they are set here.
  add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors ${OMNI_APP_ORIGIN}; sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox" always;
  add_header Access-Control-Allow-Origin "${OMNI_APP_ORIGIN}" always;
  add_header Vary "Origin" always;

  include /etc/nginx/snippets/reports-locations.conf;
}
