# /etc/omniswarm/worker.env  (root:root 0600)
# Read by systemd as root for every omniswarm-worker@N.service instance
# (EnvironmentFile=), then handed to the worker process only. Never mounted
# into a container; the worker passes the engine an allow-listed env, and the
# engine never hands keys to the sandbox (AGENTS.md "Key policy").
#
# The worker unit itself sets WORKER_ID, ENGINE_ROOT, TMPDIR, AUDIT_TMP, HOME
# and OPERATOR_KEY_FILE (a systemd credential, see the unit); do not repeat
# them here.

# Postgres is published on 127.0.0.1:5432 only (compose.prod.yml).
DATABASE_URL=
# Jobs this instance runs at once. Total = instances x WORKER_CONCURRENCY.
WORKER_CONCURRENCY=1
# Published report folders, served read-only by nginx from the reports origin.
REPORTS_ROOT=/srv/omniswarm/reports
# Private attempt dirs (engine output, worker.log, result.json). Must be under
# /srv/omniswarm/work: the unit's ReadWritePaths; the release tree is read-only.
# The worker's own hygiene keeps the newest KEEP_RUNS (apps/api, default 20).
RUNS_ROOT=/srv/omniswarm/work/runs
# Public base URL of the published reports (nginx reports origin). Required in
# production; it becomes the attested reportUri prefix.
REPORTS_BASE_URL=
NETWORK=testnet
CONTRACT_ID=
RPC_URLS=
# Must equal stack.env HOSTED_PRESET (secrets-check.mjs compares them).
HOSTED_PRESET=hosted
# Must equal stack.env ALLOWED_PRESETS and ACCOUNT_KEYS_SECRET: the worker decrypts an
# account's own provider key (account- presets) with it. Never SESSION_SECRET here.
ALLOWED_PRESETS=
ACCOUNT_KEYS_SECRET=
# Opt-in to real provider calls. Without OMNI_LIVE=1 the engine refuses every API-provider
# request (live_required) and a hosted review fails and is refunded.
OMNI_LIVE=1
