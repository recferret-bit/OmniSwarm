# @omniswarm/api environment, validated at startup by src/config/env.ts (a bad value exits with one line).
# Entry points: `npm start -w @omniswarm/api` (HTTP), `npm run worker -w @omniswarm/api`, `npm run db:migrate -w @omniswarm/api`.
# Uncommented keys are the contract a deployment delivers (infra/check/env-contract.mjs checks it).
# Commented keys are optional, shown with their default. `KEY=` means unset. No secret has a default.
# Secrets live in /etc/omniswarm/*.env (root 0600) on a host, never in the repo.

# --- database (one Postgres: requests, nonces, rate limits and the pg-boss queue); the only key db:migrate reads ---
DATABASE_URL=
# DATABASE_POOL_MAX=10
# NODE_ENV=production                # set by the image; production refuses every test adapter below
# LOG_LEVEL=info

# --- public HTTP (API process) ---
HOST=127.0.0.1                       # 0.0.0.0 inside a container
PORT=8787
TRUST_PROXY=false                    # false | true | hop count | comma list of proxy addresses/CIDRs
SESSION_SECRET=                      # required, >= 32 chars (openssl rand -base64 48)
# COOKIE_SECURE=1                    # defaults to on in production and cannot be turned off there
# LANDING_ORIGIN=                    # allow CORS from this origin only
# RATE_LIMIT_PER_MINUTE=30           # per client IP and route, shared by all replicas
# REQUESTS_PER_DAY=5                 # per account

# --- admin listener (same process, loopback only, separate port; never published or proxied) ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
ADMIN_TOKEN=                         # >= 32 chars; required in production. Refunds it accepts are queued;
                                     # a worker signs them (only workers hold the operator key)

# --- intake rules ---
NETWORK=testnet
PRICE_YOCTO=1000000000000000000000000   # price on NETWORK; mainnet stays disabled until set
INTAKE_RECIPIENT=omniswarm.testnet   # NEP-413 recipient the wallet signs for
CONTRACT_ID=                         # registry contract; must equal the web app's NEXT_PUBLIC_CONTRACT_ID
MAX_REPO_KB=204800
HOSTED_PRESET=hosted                 # the preset a signed (wallet) request names; required in production. With the cli
                                     # engine the worker checks at startup that it exists in omniswarm.config.json
                                     # and runs only hosted families (no cli:*, no scripted). Default `hosted` (OD-04);
                                     # `scripted` only with ENGINE_RUNNER=mock (tests, local stack)
ALLOWED_PRESETS=                     # empty = HOSTED_PRESET only; add account-nearai for accounts' own NEAR AI keys
OMNI_LIVE=                           # 1 = the worker lets the engine make real provider calls (otherwise live_required)
ACCOUNT_KEYS_SECRET=                 # seals accounts' own provider keys (>= 32 chars); required in production with an account- preset
# MAX_QUEUE=10
# ETA_MINUTES_PER_JOB=15
# REPO_ALLOWLIST=                    # comma list of owner/repo or owner/*; empty = all public repos
# REPO_DENYLIST=
# REVIEW_SETTINGS_FILE=              # API only: JSON file for the admin page's free-checks switch; unset = free checks off

# --- chain ---
RPC_URLS=                            # comma list, failover in order (FastNEAR, then Lava)
OPERATOR_KEY_FILE=                   # WORKER ONLY: near-cli credentials JSON or ed25519:<secret>, mode 0600
# OPERATOR_ACCOUNT_ID=               # defaults to the key file's account_id
CHAIN_ADAPTER=near                   # production default; `mock` is for tests and the local demo
# MOCK_CHAIN_FAIL_RATE=0

# --- guard (API) ---
# GUARD_ACCOUNT_AGE=off              # off | nearblocks (account-age signal from the NearBlocks API; off = unavailable)
# NEARBLOCKS_API_KEY=                # optional, raises the NearBlocks rate limit; never passed to the engine

# --- GitHub ---
GITHUB_TOKEN=                        # optional, public-repo read only; raises the rate limit
GITHUB_ADAPTER=live                  # production default; `recorded` is for tests
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_MS=5000

# --- worker and engine ---
WORKER_ID=                           # label of this worker instance (logs, pg-boss instance name)
WORKER_CONCURRENCY=1
ENGINE_ROOT=                         # repository root; the worker spawns $ENGINE_ROOT/bin/audit with cwd there
REPORTS_ROOT=                        # published, read-only reports (served by nginx from the reports origin)
REPORTS_BASE_URL=                    # origin serving REPORTS_ROOT; https in production, http on the local stack
# ENGINE_RUNNER=cli                  # production default; `mock` is for tests and the local demo
# ENGINE_CONFIG=                     # default $ENGINE_ROOT/omniswarm.config.json (preset -> provider keys)
# ENGINE_TIMEOUT_S=5400              # below QUEUE_EXPIRE_S
# ENGINE_KILL_GRACE_S=30
# ENGINE_LOG_MAX_BYTES=5242880
# ENGINE_ENV_PASSTHROUGH=            # extra variable names for the engine; intake secrets are refused
RUNS_ROOT=                           # host-only attempt dirs; default reports/intake/runs
# KEEP_RUNS=20                       # finished requests whose RUNS_ROOT dirs are kept (older ones removed)
# ORPHAN_REPORT_RETENTION_H=168      # a published report of a refunded/expired request is removed after this;
                                     # a done (attested) request's report is never removed
# WORKER_STOP_TIMEOUT_S=120          # SIGTERM drain; engines get SIGTERM at once
# PROGRESS_POLL_MS=5000

# --- queue timings (applied by db:migrate) ---
# QUEUE_EXPIRE_S=7200
# QUEUE_HEARTBEAT_S=30
# QUEUE_RETRY_LIMIT=1
# QUEUE_RETRY_DELAY_S=60
# QUEUE_MONITOR_S=30

# There are no operator provider keys for accounts' reviews: a dashboard review runs only on the signed-in
# account's own NEAR AI Cloud key (sealed in Postgres under ACCOUNT_KEYS_SECRET). Keys a configured
# HOSTED_PRESET needs (e.g. NEARAI_API_KEY) go only in the worker's env.
