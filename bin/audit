#!/usr/bin/env bash
set -euo pipefail

# audit
# Entry CLI for the multi-agent security check and security review suite.
# It audits any repository, in exactly one of two modes:
#   local   --repo <path>       a directory already on disk
#   remote  --github <url>      cloned into /tmp, audited, optionally removed (--clean)
#
# Commands:
#   run     --repo <path> | --github <url> [options]   Run the multi-agent quorum review
#   verify  [<report-dir>]                             Quorum adjudication + scoring on a report dir
#   html    [<report-dir>]                             Regenerate report.html and findings-by-model.html
#   report  [<report-dir>]                             Show findings and risk scores

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# The review engine (scripts/, docker/, native/, skills/, runtime/, eval/) lives under engine/.
# Run output (reports/) and the operator's omniswarm.config.json stay at the repository root.
AUDIT_ROOT="$REPO_ROOT/engine"
# shellcheck source=../engine/scripts/resolve-target.sh
source "$AUDIT_ROOT/scripts/resolve-target.sh"

COMMAND="${1:-help}"
shift || true

ARG_REPO="" ARG_GITHUB="" ARG_REF="" ARG_WORKDIR="" ARG_CLEAN=0
SURFACE="all" SCOPE="full" OUT_DIR="" POSITIONAL=()
PLAN=0
RPC="" RESUME_FROM="" TEST_ARTIFACTS="" RESTART_FAILED=0
REVIEWER_ARGS=()   # reviewer, model, preset and budget flags, resolved by engine/scripts/run-config.mjs

# Flags for `run`; anything else is a positional argument.
parse_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo|--path|-r) ARG_REPO="${2:?$1 needs a path}"; shift 2 ;;
      --github|--gh|-g) ARG_GITHUB="${2:?$1 needs a URL}"; shift 2 ;;
      --ref|--branch) ARG_REF="${2:?$1 needs a branch, tag or sha}"; shift 2 ;;
      --workdir) ARG_WORKDIR="${2:?--workdir needs a path}"; shift 2 ;;
      --clean) ARG_CLEAN=1; shift ;;
      --surface|-s) SURFACE="${2:?$1 needs a value}"; shift 2 ;;
      --scope) SCOPE="${2:?--scope needs full, web2, web3 or infra}"; shift 2 ;;
      --out|-o) OUT_DIR="${2:?$1 needs a path}"; shift 2 ;;
      --agents|-a) REVIEWER_ARGS+=(--agents "${2:?$1 needs a list}"); shift 2 ;;
      --reviewers|--config|--preset|--assign|--orchestrator|--alternate-judge|--passes|--tool-budget|--max-cost-usd|--debate-rounds|--debate-max-clusters|--debate-tool-budget|--debate-turn-ms|--debate-phase-ms|--pipeline|--concurrency|--model|--models|--model-claude|--model-grok|--model-agy|--model-codex)
        REVIEWER_ARGS+=("$1" "${2:?$1 needs a value}"); shift 2 ;;
      --step-by-step|--no-debate)
        REVIEWER_ARGS+=("$1"); shift ;;
      --claude-model|--grok-model|--agy-model|--codex-model)
        agent="${1#--}"; REVIEWER_ARGS+=("--model-${agent%-model}" "${2:?$1 needs a value}"); shift 2 ;;
      --plan) PLAN=1; shift ;;
      --resume-from) RESUME_FROM="${2:?--resume-from needs a report directory}"; shift 2 ;;
      --test-artifacts) TEST_ARTIFACTS="${2:?--test-artifacts needs a Cargo target directory}"; shift 2 ;;
      --restart-failed) RESTART_FAILED=1; shift ;;
      --rpc) RPC="${2:?--rpc needs an https URL}"; shift 2 ;;
      -*) die "unknown option: $1 (see 'audit help')" ;;
      *) POSITIONAL+=("$1"); shift ;;
    esac
  done
}

# The newest directory under reports/ that holds findings, auditor logs or a meta file.
latest_report() {
  local d
  for d in $(ls -1dt "$REPO_ROOT"/reports/*/ 2>/dev/null); do
    if [ -d "${d}auditors" ] || [ -f "${d}findings-and-scores.json" ]; then
      printf '%s' "${d%/}"
      return 0
    fi
  done
  return 1
}

report_dir_arg() {
  if [ -n "${1:-}" ]; then printf '%s' "$1"; else latest_report || die "no report found under $REPO_ROOT/reports; pass a report directory"; fi
}

case "$COMMAND" in
  setup-agents)
    [ "$#" -eq 0 ] || die "setup-agents takes no arguments"
    npm --prefix "$AUDIT_ROOT/runtime" ci --ignore-scripts --no-audit --no-fund
    ;;
  grok-docker)
    node "$AUDIT_ROOT/native/grok-review/docker.mjs" "$@"
    ;;
  review-with-cli)
    node "$AUDIT_ROOT/scripts/static-cli-review.mjs" "$@"
    ;;
  connect-terminal)
    node "$AUDIT_ROOT/scripts/terminal-model-connector.mjs" connect "$@"
    ;;
  check-model-cli)
    node "$AUDIT_ROOT/scripts/terminal-model-connector.mjs" check "$@"
    ;;
  check-agents|check-bridge)
    if [ "${1:-}" = "--live" ]; then
      shift
      node "$AUDIT_ROOT/scripts/session-smoke.mjs" "$@"
    elif [ "${1:-}" = "--reviewers" ]; then
      node "$AUDIT_ROOT/scripts/check-agents.mjs" "$@"
    else
      [ "$#" -eq 0 ] || die "check-agents accepts --live [--agents <list>] [--out <empty-dir>] or --reviewers <list>"
      node "$AUDIT_ROOT/scripts/docker-agent-orchestrator.mjs" --check
    fi
    ;;
  demo)
    node "$AUDIT_ROOT/scripts/audit-demo.mjs" "$@"
    ;;
  review-local)
    node "$AUDIT_ROOT/scripts/terminal-local-review.mjs" "$@"
    ;;
  local)
    node "$AUDIT_ROOT/scripts/local-cli.mjs" "$@"
    ;;
  step|advise|debate)
    node "$AUDIT_ROOT/scripts/debate-step-cli.mjs" "$COMMAND" "$@"
    ;;
  run)
    parse_flags "$@"
    [ -z "$RPC" ] || die "source security review does not contact deployed RPCs"
    trap cleanup_target EXIT
    resolve_target
    arm_cleanup
    if [ -z "$OUT_DIR" ]; then
      OUT_DIR="$REPO_ROOT/reports/$(date +%Y-%m-%d-%H%M%S)-$TARGET_NAME"
    fi
    model_args=(${REVIEWER_ARGS[@]+"${REVIEWER_ARGS[@]}"})
    [ "$PLAN" -eq 1 ] && model_args+=(--plan)
    [ -n "$RESUME_FROM" ] && model_args+=(--resume-from "$RESUME_FROM")
    [ -n "$TEST_ARTIFACTS" ] && model_args+=(--test-artifacts "$TEST_ARTIFACTS")
    [ "$RESTART_FAILED" -eq 1 ] && model_args+=(--restart-failed)
    bash "$AUDIT_ROOT/scripts/orchestrate.sh" \
      --target "$TARGET_DIR" --name "$TARGET_NAME" --mode "$TARGET_MODE" \
      --source "$TARGET_SOURCE" --ref "$TARGET_REF" --commit "$TARGET_COMMIT" \
      --surface "$SURFACE" --scope "$SCOPE" --out "$OUT_DIR" ${model_args[@]+"${model_args[@]}"}
    report_kept_clone
    ;;

  verify|adjudicate)
    node "$AUDIT_ROOT/scripts/verify-and-adjudicate.mjs" "$(report_dir_arg "${1:-}")"
    ;;

  html|web)
    node "$AUDIT_ROOT/scripts/generate-html-report.mjs" "$(report_dir_arg "${1:-}")"
    ;;

  pdf)
    node "$AUDIT_ROOT/scripts/report-pdf.mjs" "$(report_dir_arg "${1:-}")"
    ;;

  report|summary)
    TARGET_DIR_ARG="$(report_dir_arg "${1:-}")"
    if [ -f "$TARGET_DIR_ARG/findings-and-scores.json" ]; then
      node "$AUDIT_ROOT/scripts/verify-and-adjudicate.mjs" "$TARGET_DIR_ARG"
    elif [ -f "$TARGET_DIR_ARG/index.md" ]; then
      cat "$TARGET_DIR_ARG/index.md"
    else
      die "No report found in $TARGET_DIR_ARG"
    fi
    ;;

  help|--help|-h)
    cat <<'EOF'
OmniSwarm: multi-agent source security review CLI (any repository)

Pick exactly ONE target:
  --repo <path>      LOCAL mode: audit a directory on disk (alias: --path, -r)
  --github <url>     REMOTE mode: shallow-clone a GitHub repo into /tmp and audit it (alias: --gh, -g)
                     accepts https://github.com/<owner>/<repo>[.git], git@github.com:<owner>/<repo>.git, <owner>/<repo>

Usage:
  audit local [--repo <directory> | --github <owner/repo or url>] [--provider <zai|openrouter|nearai> --models <model,...> | --nearai <model,...>] [--with-clis]
      One command. Uses every installed CLI (claude, codex, grok, agy). Opus is the orchestrator when Claude is installed. With only one CLI, that model is both orchestrator and reviewer. Defaults to the current directory.
      --provider <id> --models <model,...>: review with one API provider from the provider catalog instead (the first model orchestrates). Needs that provider's key variable in your environment (ZAI_API_KEY, OPENROUTER_API_KEY or NEARAI_API_KEY); source is sent to that provider. --nearai <model,...> is shorthand for --provider nearai --models. --with-clis adds the installed CLIs.
  audit run   (--repo <path> | --github <url>) [options]
      Review supplied source/configuration/dependencies through restricted MCP tools and persistent ACP sessions. Only catalogued existing tests run in the offline Docker sandbox; no arbitrary commands, PoCs or deployed probes. Save validated peer-reviewed reports and remove owned resources.
  audit setup-agents
      Install the lockfile-pinned ACP runtime locally; no global tools or account login.
  audit check-agents [--live [--agents <list>] [--out <empty-dir>] | --reviewers <list>]
      Check Docker, CLIs and pinned adapters. --reviewers checks key presence for key/openrouter/scripted/claude-zai and never prints a key.
      --live explicitly runs inert inference, bridge access and saved-session recovery checks.
  audit demo [--surface s1|all] [--out <empty-dir>] [--no-docker]
      Review the bundled engine/scripts/demo-fixture with scripted reviewers. Refuses --repo and --github.
      Docker absent, or --no-docker, serves a read-only host snapshot stamped DEMO — not a review.
  audit verify [<report-dir>]    Validate and score model claims on an existing report directory
  audit report [<report-dir>]    Show findings and risk scores
  audit html   [<report-dir>]    Regenerate report.html and findings-by-model.html
  audit pdf    [<report-dir>]    Print report.html and findings-by-model.html to PDF with local headless Chrome
  audit step   [<report-dir>] [--rounds <1-5>] [--repo <path>] [--orchestrator <spec>] [--concurrency <1-8>]
      Advance an iterative audit to its next stage: Step 2 Frontier Orchestrator Advice, then Step 3 Debate round(s).
  audit advise [<report-dir>] [--repo <path>] [--orchestrator <spec>]
      Run or refresh Step 2 Frontier Orchestrator quality & debate advice on a Stage 1 report directory.
  audit debate [<report-dir>] [--rounds <1-5>] [--repo <path>] [--orchestrator <spec>] [--concurrency <1-8>]
      Run N additional debate round(s) (default 1) on an existing report directory, saving audit_round_<n>.* and updating pipeline-progress.json.
  (<report-dir> defaults to the newest directory under reports/)

  audit check-model-cli --all | --provider <claude|codex-native|grok-native|grok-docker>
  audit review-with-cli --repo <local-directory> --file <relative-file> --provider <claude|codex-native|grok-native|grok-docker> --model <model> --out <empty-directory>
  audit review-local --repo <local-directory> --file <relative-file> [--file <relative-file>] --out <empty-directory>
  audit connect-terminal --provider <claude|codex-native|grok-native|grok-docker> --model <requested-model> --socket <owner-only-path>
  audit grok-docker setup | login

Options (run):
  --ref <branch|tag|sha>   --github only: revision to check out (default: the default branch)
  --workdir <dir>          --github only: clone base directory (default: $AUDIT_TMP or /tmp/audit-targets)
  --clean                  --github only: delete the clone when the run ends (default: keep it)
  --test-artifacts <dir>   Import deploy/*.so and Anchor idl/*.json from a prebuilt Cargo target directory; hashes are recorded, source equivalence remains unverified
  --restart-failed         With --resume-from, review failed assignments in new sessions; provider refusals, quotas and login errors remain blocked
  -s, --surface <id>       s1..s6 or all (default: all)
  -o, --out <dir>          report directory (default: reports/<timestamp>-<repo>)
  --reviewers <list>       comma-separated reviewer specs <family>:<provider>:<model>[#label]. Families: cli (claude, codex, grok, agy,
                           claude-zai), key (zai), openrouter (<vendor>/<model>), scripted (fixture strategies, demo only).
                           Example: cli:claude:opus,cli:codex:gpt-6.1-sol,key:zai:glm-5.3,openrouter:qwen/qwen3.8-max-0902
  --config <file>          run config (default: omniswarm.config.json at the OmniSwarm repository root, if present); see engine/omniswarm.config.example.json
  --preset <name>          a preset from the config file (local-subscriptions, api-only, mixed, hosted, demo)
  --assign <mode>          matrix (every reviewer x every surface; default with --reviewers/--preset up to 8 reviewers)
                           or round-robin (one reviewer per surface; default with --agents)
  --orchestrator <spec|recommended>   model that judges the debate and writes the general review; without it there is no debate.
                           recommended takes the first available of cli:claude:opus, key:anthropic, openrouter:anthropic, key:zai,
                           scripted:judge. scripted:judge (the citation rules, no model) is refused on anything but the bundled
                           fixtures (scripted_judge_demo_only)
  --alternate-judge <spec>            judge for a cluster whose authors share the orchestrator's vendor
                           (default: the first run reviewer of another vendor; with none the cluster stays DISPUTED)
  --debate-rounds <n>      debate rounds, 1-3 (default 2, the golden-eval rule in engine/eval/RESULTS.md)
  --pipeline <mode>        full (Stage 1 + Frontier Advice + Debates, default), step-by-step (Stage 1 + Frontier Advice, optional iterative debates), or stage-1 (Stage 1 only, no debates)
  --step-by-step           shorthand for --pipeline step-by-step
  --no-debate              shorthand for --pipeline stage-1
  --concurrency <n>        parallel worker lanes per provider and across debate/adjudication clusters, 1-8 (default 3)
  --debate-max-clusters <n>  clusters debated, 1-500 (default 25); the rest are listed as coverage gaps
  --debate-tool-budget <n> read calls per debate turn or judgement, 1-100 (default 12), plus its submit
  --debate-turn-ms <n>     wall clock per debate turn, judgement, or general review, 15000-600000 (default 180000). The session is aborted
  --debate-phase-ms <n>    wall clock for the speaking phase, 60000-3600000 (default 900000). Clusters not started are a debate_time coverage gap
  --passes <n>             passes per reviewer, 1-5 (default 2)
  --tool-budget <n>        inspection calls per pass, 5-200 (default 40), plus 3 calls to submit; enforced by the bridge and each session
  --max-cost-usd <usd>     stop a reviewer's API spend at this ceiling; its later passes are skipped and recorded
  Flags override the preset, the preset overrides the config file, the file overrides the defaults.
  -a, --agents <list>      alias: comma-separated subset of claude,grok,agy,codex (default: claude,grok,agy,codex), each a cli: reviewer
  --model <slug>           alias: use this model for every selected agent
  --models <list>          alias, per vendor: claude=<slug>,grok=<slug>,agy=<slug>,codex=<slug>
  --claude-model <slug>    one vendor's model. Also --grok-model, --agy-model, --codex-model (aliases: --model-<vendor>)
                           precedence: --<vendor>-model, then --models, then --model, then the default
  --resume-from <report>   continue saved source-review sessions with matching workflow, source, reviewers, models and assignments
  --plan                   print the reviewer table, assignment, budgets and orchestrator, then exit before the harness (exit 2 if a family is not installed)

Surfaces:
  s1, auth     Identity & access control
  s2, input    Input handling & injection
  s3, logic    Business logic & value flows
  s4, config   Secrets, config & infrastructure
  s5, deps     Dependencies & supply chain
  s6, client   Client & web surface
  all          every surface (matrix: each reviewer reviews each one; round-robin: one reviewer per surface)

Examples:
  audit check-agents
  audit run --github https://github.com/owner/repo
  audit run --github owner/repo --ref v1.2.0 --surface s1 --clean
  audit run --repo ~/work/my-app --agents claude,grok,agy,codex
  audit run --repo . --surface s1 --model-codex gpt-6.1-sol
  audit run --repo . --models claude=opus,codex=gpt-6.1-sol --plan
  audit run --repo . --reviewers cli:claude:opus,cli:codex:gpt-6.1-sol --assign matrix --plan
  audit run --repo . --preset local-subscriptions --plan
EOF
    ;;

  *)
    die "Unknown command: $COMMAND. Run 'audit help' for usage."
    ;;
esac
