# Local stack overrides (infra/compose/dev-env.sh layers this over
# stack.env.example and fills every remaining empty secret with random hex).
# Nothing here is a secret. Used by `infra/compose/local.sh` and by the
# bring-up in `infra/check.sh`. Ports are loopback-only.
OMNI_DOMAIN=omniswarm.localhost
OMNI_REPORTS_DOMAIN=reports.omniswarm.localhost
OMNI_HTTP_PORT=18480
OMNI_PG_PORT=55873
# Admin page basic auth. The password is filled by dev-env.sh when empty.
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=
# Host directory the API container and the host workers share. dev-env.sh fills it.
OMNI_SECRETS_DIR=
# nginx basic-auth file for /admin. dev-env.sh writes it from ADMIN_BASIC_*.
OMNI_ADMIN_HTPASSWD=
OMNI_ACME_EMAIL=dev@omniswarm.localhost
# Unauthenticated GitHub API in local runs.
GITHUB_TOKEN=
NETWORK=testnet
CONTRACT_ID=review-registry.mock
INTAKE_RECIPIENT=omniswarm.testnet
RPC_URLS=http://127.0.0.1:9/unused-in-mock-mode
PRICE_YOCTO=1000000000000000000000000
HOSTED_PRESET=scripted
# Development build of the api image and the mock chain: migrate keeps the mock
# tables, and the foreground worker (local.sh) runs the mock engine.
OMNI_API_NODE_ENV=development
CHAIN_ADAPTER=mock
GITHUB_ADAPTER=live
ENGINE_RUNNER=mock
# Web build args. The contract id matches CONTRACT_ID; the RPC URL is only
# reached by the browser when a report page reads an attestation.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=review-registry.mock
NEXT_PUBLIC_INTAKE_RECIPIENT=omniswarm.testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
# Local NEAR (W15). NEAR_LOCAL=0 keeps the mock URLs above, which stack:local
# still builds. W15-11 turns this on and points RPC_URLS and the NEXT_PUBLIC
# RPC and explorer URLs at the sandbox (http://127.0.0.1:3030 and :3031).
NEAR_LOCAL=0
NEAR_NETWORK=sandbox
NEXT_PUBLIC_WALLET=local
GUARD_ACCOUNT_AGE_URL=http://127.0.0.1:3031
DEV_WALLET_URL=http://127.0.0.1:3031
