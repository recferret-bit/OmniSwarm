# /etc/omniswarm/stack.env  (root:root 0600)
# Read by `docker compose --env-file` (infra/deploy/lib.sh) and nowhere else.
# Compose maps each value into exactly the services that need it
# (infra/compose/compose.yml); nothing here is passed through wholesale.
#
# An empty value means "the owner must set this". Every compose reference to an
# empty variable here uses ${VAR:?}, so `docker compose up` refuses to start
# until it is filled (`npm run check:infra` proves that for each one).
# Never commit a filled copy. Keep the owner's copy in ~/.omniswarm/env/.

# --- Deployment --------------------------------------------------------------
# Public hostnames. Both need DNS A records and are on one certificate.
OMNI_DOMAIN=
OMNI_REPORTS_DOMAIN=
# Number of API containers behind nginx (`--scale api=N` overrides it).
OMNI_API_REPLICAS=2
# Host paths mounted into containers.
OMNI_TLS_DIR=/etc/letsencrypt
OMNI_ACME_DIR=/srv/omniswarm/acme
OMNI_REPORTS_DIR=/srv/omniswarm/reports
OMNI_NGINX_DIR=/srv/omniswarm/nginx
# Let's Encrypt account e-mail (infra/deploy/certbot.sh).
OMNI_ACME_EMAIL=

# --- Postgres ----------------------------------------------------------------
# Readers: postgres, migrate, api (inside compose). The host workers carry their
# own DATABASE_URL in worker.env with the same password.
POSTGRES_PASSWORD=

# --- API (container env) -----------------------------------------------------
# Readers: api only (migrate gets DATABASE_URL and nothing else).
SESSION_SECRET=
ADMIN_TOKEN=
# Optional fine-grained token, public-repo read only. Empty = unauthenticated.
GITHUB_TOKEN=
NETWORK=testnet
CONTRACT_ID=
INTAKE_RECIPIENT=
RPC_URLS=
PRICE_YOCTO=
MAX_REPO_KB=204800
# The preset a paid (wallet) request is reviewed with (engine omniswarm.config.json).
# The paid landing flow is dormant: the landing page has no quote or pay form, and
# OmniSwarm puts no operator key on the host (providers.env is empty, OD-26).
# `demo` spends nothing.
HOSTED_PRESET=hosted
# Presets a signed request may name. Empty = HOSTED_PRESET only. `hosted,account-nearai`
# also lets a signed-in account review on its own NEAR AI Cloud key and models
# (dashboard reviews always use account-nearai)
# (packages/schemas/providers.mjs, docs/providers.md). Must match worker.env.
ALLOWED_PRESETS=
# Seals accounts' own provider keys in Postgres (>= 32 chars, openssl rand -base64 48).
# Every dashboard review runs on an account's own key (account-nearai), so set it;
# secrets-check.mjs enforces it once ALLOWED_PRESETS has an account- preset. Same value in worker.env.
ACCOUNT_KEYS_SECRET=
# api image build (NODE_ENV) and adapters for api and migrate. Production
# refuses the test adapters; only the local stack (dev.env.example) changes these.
OMNI_API_NODE_ENV=production
CHAIN_ADAPTER=near
GITHUB_ADAPTER=live

# --- Web (build args, inlined into the browser bundle) ----------------------
# Readers: the web image build only. Public values; never put a secret here.
# NEXT_PUBLIC_CONTRACT_ID must equal CONTRACT_ID, or every payment stops at
# CONTRACT_MISMATCH in the browser.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_INTAKE_RECIPIENT=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
# Optional donation section (dashboard and the end of the landing page): a NEP-141
# ft_transfer of USDC with 1 yoctoNEAR attached. Empty recipient = no section.
# The recipient must be storage-registered on the USDC contract, or the transfer
# fails (docs/ops/OWNER_TASKS.md). Leave the contract empty to use the network's
# USDC. The sandbox has no default USDC contract.
#   mainnet 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
#   testnet 3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
NEXT_PUBLIC_DONATION_ACCOUNT=
NEXT_PUBLIC_DONATION_USDC_CONTRACT=
