{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/guard-mcp.schema.json",
  "title": "guard-mcp",
  "description": "Input and output of the read-only guard MCP tools (W18). The server holds no key and does not sign. Validate one with validate('guard-mcp#<def>', value).",
  "$defs": {
    "guard-verdict-input": {
      "type": "object",
      "required": ["account"],
      "additionalProperties": false,
      "properties": {
        "account": {"$ref": "intake-api.schema.json#/$defs/account-id"},
        "network": {"$ref": "intake-api.schema.json#/$defs/network"}
      }
    },
    "get-attestation-input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["account"],
          "additionalProperties": false,
          "properties": {"account": {"$ref": "intake-api.schema.json#/$defs/account-id"}}
        },
        {
          "type": "object",
          "required": ["request_hash"],
          "additionalProperties": false,
          "properties": {"request_hash": {"$ref": "intake-api.schema.json#/$defs/sha256-hex"}}
        }
      ]
    },
    "is-reported-input": {
      "type": "object",
      "required": ["account"],
      "additionalProperties": false,
      "properties": {"account": {"$ref": "intake-api.schema.json#/$defs/account-id"}}
    },
    "guard-verdict-output": {"$ref": "intake-api.schema.json#/$defs/guard-verdict-response"},
    "get-attestation-output": {
      "type": "object",
      "required": ["attestation"],
      "additionalProperties": false,
      "properties": {
        "attestation": {
          "oneOf": [
            {"$ref": "attestation.schema.json"},
            {"type": "null"}
          ]
        }
      }
    },
    "is-reported-output": {
      "type": "object",
      "required": ["reported"],
      "additionalProperties": false,
      "properties": {"reported": {"type": "boolean"}}
    }
  }
}
