# /etc/omniswarm/ops.env  (root:root 0600)
# Read by systemd for the host timers only: omniswarm-health, omniswarm-prune
# and omniswarm-log-hygiene (infra/systemd/). Never reaches a container, the
# worker or the sandbox. Every value is optional.

# Alert hook. On a failure (after OMNI_HEALTH_RESTART_AFTER runs in a row), on
# its recovery, on a disk alarm and on a log-hygiene hit, the host POSTs
# {"text": "...", "content": "..."} here: a Slack or Discord incoming webhook,
# or any endpoint that takes a JSON POST. Treat the URL as a secret.
OMNI_ALERT_WEBHOOK_URL=
# Dead-man switch: fetched (GET) after every all-green health run, e.g. a
# healthchecks.io or Uptime Kuma push URL. The external service alerts when
# the pings stop, which also covers a host that is down (docs/ops/UPTIME.md).
OMNI_HEARTBEAT_URL=
# Consecutive failed health runs (one a minute) before the host repairs the
# check's services and alerts.
OMNI_HEALTH_RESTART_AFTER=2
# Disk alarm for /srv/omniswarm and Docker's data root, in percent used.
OMNI_DISK_ALARM_PCT=80
# Private attempt dirs (RUNS_ROOT) are pruned after this many days, but not
# before OMNI_PRUNE_NOT_BEFORE. Published reports are never pruned.
OMNI_RUNS_KEEP_DAYS=30
OMNI_PRUNE_NOT_BEFORE=2026-12-31
