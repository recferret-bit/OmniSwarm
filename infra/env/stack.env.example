# /etc/omniswarm/stack.env  (root:root 0600)
# Read by `docker compose --env-file` (infra/deploy/lib.sh) and nowhere else.
# Compose maps each value into exactly the services that need it
# (infra/compose/compose.yml); nothing here is passed through wholesale.
#
# An empty value means "the owner must set this". Every compose reference to an
# empty variable here uses ${VAR:?}, so `docker compose up` refuses to start
# until it is filled (`npm run check:infra` proves that for each one).
# Never commit a filled copy. Keep the owner's copy in ~/.omniswarm/env/.

# --- Deployment --------------------------------------------------------------
# Public hostnames. Both need DNS A records and are on one certificate.
OMNI_DOMAIN=
OMNI_REPORTS_DOMAIN=
# Number of API containers behind nginx (`--scale api=N` overrides it).
OMNI_API_REPLICAS=2
# Host paths mounted into containers.
OMNI_TLS_DIR=/etc/letsencrypt
OMNI_ACME_DIR=/srv/omniswarm/acme
OMNI_REPORTS_DIR=/srv/omniswarm/reports
OMNI_NGINX_DIR=/srv/omniswarm/nginx
# Let's Encrypt account e-mail (infra/deploy/certbot.sh).
OMNI_ACME_EMAIL=

# --- Postgres ----------------------------------------------------------------
# Readers: postgres, migrate, api (inside compose). The host workers carry their
# own DATABASE_URL in worker.env with the same password.
POSTGRES_PASSWORD=

# --- API (container env) -----------------------------------------------------
# Readers: api only (migrate gets DATABASE_URL and nothing else).
SESSION_SECRET=
ADMIN_TOKEN=
# Optional fine-grained token, public-repo read only. Empty = unauthenticated.
GITHUB_TOKEN=
NETWORK=testnet
CONTRACT_ID=
INTAKE_RECIPIENT=
RPC_URLS=
PRICE_YOCTO=
MAX_REPO_KB=204800
HOSTED_PRESET=
