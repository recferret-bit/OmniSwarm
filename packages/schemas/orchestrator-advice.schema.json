{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/orchestrator-advice.schema.json",
  "title": "orchestrator-advice",
  "description": "Step 2 frontier orchestrator evaluation of Stage 1 review quality, gaps, issues, and debate depth recommendation.",
  "type": "object",
  "required": ["stage", "quality", "debateAdvice", "nextSteps", "generatedBy", "disclaimer"],
  "additionalProperties": false,
  "properties": {
    "stage": { "const": "stage-2-advice" },
    "quality": {
      "type": "object",
      "required": ["rating", "summary", "coverageGaps", "issues"],
      "additionalProperties": false,
      "properties": {
        "rating": { "enum": ["strong", "adequate", "degraded", "incomplete"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "coverageGaps": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "issues": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "debateAdvice": {
      "type": "object",
      "required": ["debateNeeded", "recommendedDepth", "recommendedRounds", "focusClusterIds", "rationale"],
      "additionalProperties": false,
      "properties": {
        "debateNeeded": { "type": "boolean" },
        "recommendedDepth": { "enum": ["none", "shallow", "standard", "deep"] },
        "recommendedRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
        "focusClusterIds": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^(CLUSTER|cluster)-[1-9][0-9]*$" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "oneOf": [
        {
          "properties": {
            "debateNeeded": { "const": false },
            "recommendedDepth": { "const": "none" },
            "recommendedRounds": { "const": 0 }
          }
        },
        {
          "properties": {
            "debateNeeded": { "const": true },
            "recommendedDepth": { "enum": ["shallow", "standard", "deep"] },
            "recommendedRounds": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        }
      ]
    },
    "nextSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "generatedBy": {
      "type": "object",
      "required": ["mode", "orchestrator"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["model", "rules_fallback"] },
        "orchestrator": { "type": "string", "minLength": 1 },
        "fallbackReason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "disclaimer": { "const": "Model agreement and passing checks do not certify security." }
  }
}
