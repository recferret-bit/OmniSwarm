{
  "name": "@omniswarm/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/msw-worker.mjs --dev && next dev",
    "build": "node scripts/msw-worker.mjs && next build",
    "start": "next start",
    "gen:api": "node scripts/gen-api.mjs",
    "typecheck": "node scripts/gen-api.mjs --check && tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "guard": "node scripts/guard-bundle.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@omniswarm/schemas": "*",
    "near-api-js": "7.4.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@next/env": "16.4.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "msw": "3.0.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
