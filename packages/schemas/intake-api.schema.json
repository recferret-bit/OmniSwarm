{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/intake-api.schema.json",
  "title": "intake-api",
  "description": "Request and response DTOs of every intake endpoint (INTAKE section 4). Validate one with validate('intake-api#<def>', value). Examples are named valid-<def>--<label>.json.",
  "$defs": {
    "account-id": {"type": "string", "pattern": "^[a-z0-9._-]{2,64}$"},
    "network": {"enum": ["testnet", "mainnet", "sandbox"]},
    "sha256-hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit-sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"},
    "yocto": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,38})$"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "status": {"enum": ["awaiting_payment", "queued", "running", "publishing", "done", "failed", "refunded", "expired"]},
    "severity": {"enum": ["critical", "high", "medium", "low", "info", "none"]},
    "error-code": {
      "enum": ["VALIDATION_ERROR", "REPO_INVALID", "REPO_NOT_FOUND", "REPO_PRIVATE", "REPO_ARCHIVED", "REPO_TOO_LARGE", "REPO_DENIED", "QUEUE_FULL", "NONCE_EXPIRED", "NONCE_USED", "NONCE_UNKNOWN", "SIG_INVALID", "KEY_NOT_FULL_ACCESS", "ACCOUNT_MISMATCH", "MESSAGE_INVALID", "PAYMENT_NOT_FOUND", "PAYMENT_MISMATCH", "TX_ALREADY_USED", "ACTIVE_REQUEST_EXISTS", "RATE_LIMITED", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "CHAIN_UNAVAILABLE", "GITHUB_UNAVAILABLE", "INTERNAL", "REF_NOT_FOUND", "REF_CHANGED", "NETWORK_DISABLED", "PRESET_NOT_ALLOWED", "PAYLOAD_TOO_LARGE", "PAYMENT_SIGNER_MISMATCH", "INVALID_TRANSITION", "REFUND_NOT_ALLOWED", "REQUEST_NOT_FOUND"]
    },
    "error-response": {
      "type": "object",
      "required": ["error"],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": {"$ref": "#/$defs/error-code"},
            "message": {"type": "string", "minLength": 1, "maxLength": 2000},
            "retryable": {"type": "boolean"}
          }
        }
      }
    },
    "challenge-request": {"type": "object", "additionalProperties": false},
    "challenge-response": {
      "type": "object",
      "required": ["nonce", "expiresAt"],
      "additionalProperties": false,
      "properties": {"nonce": {"$ref": "#/$defs/nonce"}, "expiresAt": {"$ref": "#/$defs/timestamp"}}
    },
    "quote-request": {
      "type": "object",
      "required": ["repoUrl", "network"],
      "additionalProperties": false,
      "properties": {
        "repoUrl": {"type": "string", "minLength": 1, "maxLength": 300},
        "network": {"$ref": "#/$defs/network"},
        "ref": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "quote-response": {
      "type": "object",
      "required": ["normalizedRepo", "commitSha", "priceYocto", "contractId", "queueDepth", "preset", "etaMinutes"],
      "additionalProperties": false,
      "properties": {
        "normalizedRepo": {"$ref": "#/$defs/repo"},
        "commitSha": {"$ref": "#/$defs/commit-sha"},
        "priceYocto": {"$ref": "#/$defs/yocto"},
        "contractId": {"$ref": "#/$defs/account-id"},
        "queueDepth": {"type": "integer", "minimum": 0},
        "preset": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
        "etaMinutes": {"type": "integer", "minimum": 0},
        "sizeKb": {"type": "integer", "minimum": 0},
        "large": {"type": "boolean"},
        "freeChecks": {"type": "boolean"}
      }
    },
    "create-request-body": {
      "type": "object",
      "required": ["accountId", "publicKey", "signature", "message", "nonce"],
      "additionalProperties": false,
      "properties": {
        "accountId": {"$ref": "#/$defs/account-id"},
        "publicKey": {"type": "string", "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]{32,64}$"},
        "signature": {"type": "string", "minLength": 1, "maxLength": 512},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "nonce": {"$ref": "#/$defs/nonce"}
      }
    },
    "create-request-response": {
      "type": "object",
      "required": ["requestId", "requestHash", "priceYocto", "contractId"],
      "additionalProperties": false,
      "properties": {
        "requestId": {"$ref": "#/$defs/uuid"},
        "requestHash": {"$ref": "#/$defs/sha256-hex"},
        "priceYocto": {"$ref": "#/$defs/yocto"},
        "contractId": {"$ref": "#/$defs/account-id"}
      }
    },
    "payment-request": {
      "type": "object",
      "required": ["txHash"],
      "additionalProperties": false,
      "properties": {"txHash": {"type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{43,44}$"}}
    },
    "payment-response": {
      "description": "The request after its payment was confirmed. A replay of the same tx is idempotent and answers with the current status; position is the 1-based queue rank while queued, else null.",
      "type": "object",
      "required": ["status", "position"],
      "additionalProperties": false,
      "properties": {"status": {"$ref": "#/$defs/status"}, "position": {"type": ["integer", "null"], "minimum": 1}}
    },
    "progress": {
      "type": "object",
      "required": ["phase"],
      "additionalProperties": false,
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string"},
        "pass": {"type": "integer", "minimum": 1},
        "percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "request-status-response": {
      "type": "object",
      "required": ["status", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "progress": {"$ref": "#/$defs/progress"},
        "position": {"type": "integer", "minimum": 1, "description": "Rank among queued requests; only while queued"},
        "reportUrl": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "reportSha256": {"$ref": "#/$defs/sha256-hex"},
        "incomplete": {"type": "boolean", "description": "The report was published with report-health state incomplete"},
        "attestTx": {"type": "string", "minLength": 1},
        "refundTx": {"type": "string", "minLength": 1},
        "failureCause": {"type": "string", "minLength": 1},
        "timeline": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["event", "at"],
            "additionalProperties": false,
            "properties": {"event": {"type": "string", "minLength": 1}, "at": {"$ref": "#/$defs/timestamp"}}
          }
        },
        "createdAt": {"$ref": "#/$defs/timestamp"}
      }
    },
    "progress-event": {
      "type": "object",
      "required": ["status", "at"],
      "additionalProperties": false,
      "properties": {"status": {"$ref": "#/$defs/status"}, "progress": {"$ref": "#/$defs/progress"}, "at": {"$ref": "#/$defs/timestamp"}}
    },
    "request-list-response": {
      "type": "object",
      "required": ["requests"],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["requestId", "repo", "status", "createdAt"],
            "additionalProperties": false,
            "properties": {
              "requestId": {"$ref": "#/$defs/uuid"},
              "repo": {"$ref": "#/$defs/repo"},
              "status": {"$ref": "#/$defs/status"},
              "createdAt": {"$ref": "#/$defs/timestamp"},
              "theme": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "report-index-response": {
      "type": "object",
      "required": ["requestId", "reportUrl", "reportSha256"],
      "additionalProperties": false,
      "properties": {
        "requestId": {"$ref": "#/$defs/uuid"},
        "reportUrl": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "reportSha256": {"$ref": "#/$defs/sha256-hex"},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "generalReviewUrl": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "attestation": {"$ref": "attestation.schema.json"}
      }
    },
    "guard-verdict-response": {
      "type": "object",
      "required": ["verdict", "reasons", "signals"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"enum": ["allow", "warn", "block"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "signals": {"type": "object"},
        "attestation": {"$ref": "attestation.schema.json"}
      }
    },
    "guard-report-request": {
      "type": "object",
      "required": ["account", "evidenceUrl", "reason"],
      "additionalProperties": false,
      "properties": {
        "account": {"$ref": "#/$defs/account-id"},
        "evidenceUrl": {"type": "string", "pattern": "^https://[!-~]+$", "maxLength": 2000, "description": "Visible ASCII only, so 2000 characters are the registry's 2000-byte evidence_uri limit"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$", "description": "The registry's report_address reason: 1-280 characters, not only whitespace, no control characters"}
      }
    },
    "guard-report-response": {
      "description": "202: the report waits for the owner's review (admin listener); an approved report is sent on chain as report_address by a worker. A resubmission of an open report returns the same reportId.",
      "type": "object",
      "required": ["queued"],
      "additionalProperties": false,
      "properties": {"queued": {"const": true}, "reportId": {"$ref": "#/$defs/uuid"}}
    },
    "guard-report-status": {"enum": ["pending", "approved", "reported", "rejected"]},
    "admin-guard-report-list-response": {
      "description": "GET /api/admin/guard/reports[?status=] on the loopback admin listener.",
      "type": "object",
      "required": ["reports"],
      "additionalProperties": false,
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reportId", "account", "reporter", "evidenceUrl", "reason", "status", "reportTx", "createdAt"],
            "additionalProperties": false,
            "properties": {
              "reportId": {"$ref": "#/$defs/uuid"},
              "account": {"$ref": "#/$defs/account-id"},
              "reporter": {"$ref": "#/$defs/account-id"},
              "evidenceUrl": {"type": "string", "pattern": "^https://[^\\s]+$"},
              "reason": {"type": "string", "minLength": 1},
              "status": {"$ref": "#/$defs/guard-report-status"},
              "reportTx": {"type": ["string", "null"], "minLength": 1},
              "createdAt": {"$ref": "#/$defs/timestamp"}
            }
          }
        }
      }
    },
    "admin-guard-decision-response": {
      "description": "POST /api/admin/guard/reports/:id/approve (202 approved: a worker sends report_address) or /reject (200). Repeating a decision answers with the current state; reportTx is set once the worker sent it, null when the chain already listed the account.",
      "type": "object",
      "required": ["status", "reportTx"],
      "additionalProperties": false,
      "properties": {"status": {"$ref": "#/$defs/guard-report-status"}, "reportTx": {"type": ["string", "null"], "minLength": 1}}
    },
    "ledger-response": {
      "description": "GET /api/ledger (public, W09-18): paid requests, newest first (at most 500), with the deposit paid, the model cost summed from every attempt's reviewers/*/usage.json (recorded when the request is published or refunded) and the refund. Totals cover every paid request. No account ids.",
      "type": "object",
      "required": ["entries", "totals"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["requestId", "repo", "status", "priceYocto", "paidYocto", "modelCostUsd", "reviewers"],
            "additionalProperties": false,
            "properties": {
              "requestId": {"$ref": "#/$defs/uuid"},
              "repo": {"$ref": "#/$defs/repo"},
              "status": {"$ref": "#/$defs/status"},
              "priceYocto": {"$ref": "#/$defs/yocto"},
              "paidYocto": {"$ref": "#/$defs/yocto"},
              "modelCostUsd": {"type": "number", "minimum": 0},
              "reviewers": {"type": "integer", "minimum": 0, "description": "Reviewers that reported usage; 0 until the cost is recorded"},
              "refundTx": {"type": "string", "minLength": 1}
            }
          }
        },
        "totals": {
          "type": "object",
          "required": ["requests", "salesYocto", "refundedYocto", "modelCostUsd"],
          "additionalProperties": false,
          "properties": {
            "requests": {"type": "integer", "minimum": 0},
            "salesYocto": {"$ref": "#/$defs/yocto", "description": "Deposits of paid requests that were not refunded"},
            "refundedYocto": {"$ref": "#/$defs/yocto"},
            "modelCostUsd": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "health-response": {
      "type": "object",
      "required": ["ok", "network", "queueDepth", "workers", "chain"],
      "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "network": {"$ref": "#/$defs/network"},
        "queueDepth": {"type": "integer", "minimum": 0},
        "workers": {"type": "integer", "minimum": 0},
        "chain": {
          "type": "object",
          "required": ["rpc", "contract"],
          "additionalProperties": false,
          "properties": {"rpc": {"type": "boolean"}, "contract": {"type": "boolean"}}
        }
      },
      "description": "GET /api/health: liveness plus status. chain.rpc/contract come from ChainPort.health (cached 30 s); workers counts live pg-boss worker instances."
    },
    "admin-refund-response": {
      "description": "202 refund_queued: the API recorded the refund and a worker (the only operator-key holder) sends it. 200 refunded: already refunded; refundTx is null when the tx hash was not recorded.",
      "oneOf": [
        { "type": "object", "required": ["status"], "additionalProperties": false, "properties": { "status": { "const": "refund_queued" } } },
        { "type": "object", "required": ["status", "refundTx"], "additionalProperties": false, "properties": { "status": { "const": "refunded" }, "refundTx": { "type": ["string", "null"], "minLength": 1 } } }
      ]
    },
    "ready-response": {
      "type": "object",
      "required": ["ok", "db", "queue", "migrations"],
      "additionalProperties": false,
      "properties": {"ok": {"type": "boolean"}, "db": {"type": "boolean"}, "queue": {"type": "boolean"}, "migrations": {"type": "boolean"}}
    }
  }
}
