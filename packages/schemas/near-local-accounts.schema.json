{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/near-local-accounts.schema.json",
  "title": "near-local-accounts",
  "description": "accounts.json written by the local near-sandbox seed. Paths and public ids only. Private keys stay under infra/compose/.local/near/keys/ and are not part of this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["network", "chainId", "rpcUrl", "contractId", "priceYocto", "accounts"],
  "properties": {
    "network": {"const": "sandbox"},
    "chainId": {"const": "sandbox"},
    "rpcUrl": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:3030$"},
    "contractId": {"const": "registry.test.near"},
    "priceYocto": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,38})$"},
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "operator", "treasury", "alice", "bob"],
      "properties": {
        "owner": {"$ref": "#/$defs/account"},
        "operator": {"$ref": "#/$defs/account"},
        "treasury": {"$ref": "#/$defs/account"},
        "alice": {"$ref": "#/$defs/account"},
        "bob": {"$ref": "#/$defs/account"}
      }
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "keyFile"],
      "properties": {
        "accountId": {"type": "string", "pattern": "^[a-z0-9._-]{2,64}$"},
        "keyFile": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]*$"},
        "publicKey": {"type": "string", "pattern": "^ed25519:[1-9A-HJ-NP-Za-km-z]+$"}
      }
    }
  }
}
