{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/run-config.schema.json",
  "title": "run-config",
  "description": "omniswarm.config.json: reviewers, orchestrator, iteration budget, debate, presets. Flags override it. ORCHESTRATION sections 1 and 3.",
  "type": "object",
  "required": ["reviewers"],
  "additionalProperties": false,
  "properties": {
    "reviewers": { "$ref": "#/$defs/reviewer-list" },
    "orchestrator": { "$ref": "#/$defs/orchestrator" },
    "alternateJudge": { "$ref": "reviewer-spec.schema.json" },
    "assign": { "enum": ["matrix", "round-robin"] },
    "passes": { "type": "integer", "minimum": 1, "maximum": 5 },
    "toolBudget": { "type": "integer", "minimum": 5, "maximum": 200 },
    "pipelineMode": { "enum": ["full", "step-by-step", "stage-1"] },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
    "debate": { "$ref": "#/$defs/debate" },
    "maxCostUsd": { "type": "number", "minimum": 0 },
    "grace": { "const": 3 },
    "prices": { "$ref": "#/$defs/prices" },
    "presets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "reviewer-list": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "reviewer-spec.schema.json" } },
    "orchestrator": {
      "oneOf": [
        { "$ref": "reviewer-spec.schema.json" },
        { "const": "recommended" }
      ]
    },
    "debate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rounds": { "type": "integer", "minimum": 1, "maximum": 3 },
        "toolBudget": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxClusters": { "type": "integer", "minimum": 1, "maximum": 500 },
        "turnMs": { "type": "integer", "minimum": 15000, "maximum": 600000, "description": "Wall clock for one debate turn, judgement, or general review. The harness aborts the session." },
        "phaseMs": { "type": "integer", "minimum": 60000, "maximum": 3600000, "description": "Wall clock for the speaking phase. Clusters not started are a debate_time coverage gap." }
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["inPerMTok", "outPerMTok"],
          "additionalProperties": false,
          "properties": {
            "inPerMTok": { "type": "number", "minimum": 0 },
            "outPerMTok": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewers": { "$ref": "#/$defs/reviewer-list" },
        "orchestrator": { "$ref": "#/$defs/orchestrator" },
        "alternateJudge": { "$ref": "reviewer-spec.schema.json" },
        "assign": { "enum": ["matrix", "round-robin"] },
        "passes": { "type": "integer", "minimum": 1, "maximum": 5 },
        "toolBudget": { "type": "integer", "minimum": 5, "maximum": 200 },
        "pipelineMode": { "enum": ["full", "step-by-step", "stage-1"] },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "debate": { "$ref": "#/$defs/debate" },
        "maxCostUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
