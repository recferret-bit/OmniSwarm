{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/reviewer-report.schema.json",
  "title": "reviewer-report",
  "description": "reviewers/<id>/report.json: one model's findings and verified-safe controls across all its surfaces. Finding fields are today's auditor finding fields (engine/scripts/report-contract.mjs validateAuditor).",
  "type": "object",
  "required": ["reviewer", "surfaces", "findings", "verified_safe"],
  "additionalProperties": false,
  "properties": {
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "findings": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/finding" } },
    "verified_safe": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/verified-safe" } },
    "status": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "gaps": { "type": "array", "items": { "type": "object", "required": ["surface", "reason"], "additionalProperties": false, "properties": { "surface": { "$ref": "#/$defs/surface" }, "reason": { "type": "string" } } } },
    "usage": { "type": "object" },
    "generatedAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surface": { "type": "string", "pattern": "^S[1-6]$" },
    "citation": { "type": "string", "maxLength": 1000, "pattern": "^[^:\\n]+:[1-9][0-9]*$" },
    "reviewer": {
      "type": "object",
      "required": ["id", "family", "provider", "vendor", "model"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,80}$" },
        "family": { "enum": ["cli", "key", "nearai", "scripted"] },
        "provider": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "vendor": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "servedModel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "label": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
        "keyFingerprint": { "type": "string", "pattern": "^[0-9a-f]{4}(\\.\\.\\.)?[0-9a-f]{4}$" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["title", "surface", "severity", "confidence", "location", "impact", "preconditions", "analysis", "validation", "attack", "poc", "fix"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "surface": { "$ref": "#/$defs/surface" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "confidence": { "enum": ["confirmed", "probable"] },
        "location": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } },
        "impact": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "string", "maxLength": 20000 },
        "analysis": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "attack": { "type": "array", "items": { "type": "string" } },
        "poc": { "type": "string", "maxLength": 20000 },
        "fix": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "claimId": { "type": "string" }
      }
    },
    "verified-safe": {
      "type": "object",
      "required": ["control", "how_attacked", "holds", "evidence", "provenance"],
      "additionalProperties": false,
      "properties": {
        "control": { "type": "string", "minLength": 1 },
        "how_attacked": { "type": "string", "minLength": 1 },
        "holds": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["model_assertion", "model_agreement", "existing_test", "harness_lead"] }
      }
    }
  }
}
