# @omniswarm/web environment contract. Copy to .env.local to override.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at `next build` time:
# they are public configuration, never secrets. src/lib/env.ts validates them and
# the build fails when one is malformed. `.env` carries the defaults;
# `.env.development` turns the mocks on for `npm run dev`. OmniSwarm uses NEAR
# mainnet only: the wallet connector needs no RPC or explorer setting, and
# transaction links go to https://nearblocks.io.

# real: @hot-labs/near-connect NearConnector. mock: a test-key connector for dev
# and e2e only; a production build with `real` contains no mock code (npm run guard).
NEXT_PUBLIC_WALLET=real

# Optional. NEP-413 `recipient` the wallet signs the NEAR sign-in message for. Must
# equal the API's recipient. Unset or empty: omniswarm.near.
NEXT_PUBLIC_INTAKE_RECIPIENT=

# Optional. NEAR account that receives voluntary USDC donations (landing "Support"
# section and the dashboard panel). Unset or empty: no donation UI at all. The
# account must be storage-registered on the USDC contract (storage_deposit), or
# the NEP-141 ft_transfer panics and the wallet shows the failure.
NEXT_PUBLIC_DONATION_ACCOUNT=

# Optional override of the NEP-141 native USDC contract the wallet donation calls.
# Default: mainnet native USDC
# 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1. Never point it
# at bridged USDC.e.
NEXT_PUBLIC_DONATION_USDC_CONTRACT=

# 1: MSW serves /api/* and the report files from an in-memory state machine (dev
# and e2e only). 0 or unset: the real API.
NEXT_PUBLIC_API_MOCK=0

# Development only: `next dev` proxies same-origin /api/* to this origin (the
# Fastify intake, e.g. http://127.0.0.1:8787). In production nginx serves both
# on one origin: `location /api/` -> Fastify, everything else -> this app's
# standalone server (`node apps/web/server.js` from .next/standalone), with
# /_next/static and public/ served from disk. No rewrite exists in production.
API_ORIGIN=
