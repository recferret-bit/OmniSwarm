{
  "name": "omniswarm",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "omniswarm",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "shared/schemas",
        "backend/*",
        "frontend/*",
        "packages/*"
      ],
      "bin": {
        "audit": "bin/audit",
        "omniswarm": "bin/audit"
      }
    },
    "node_modules/@omniswarm/schemas": {
      "resolved": "shared/schemas",
      "link": true
    },
    "shared/schemas": {
      "name": "@omniswarm/schemas",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
