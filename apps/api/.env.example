# @omniswarm/api environment (validated at startup by src/config/env.ts; a bad value exits with one line).
# Entry points: `npm start -w @omniswarm/api` (HTTP), `npm run worker -w @omniswarm/api`, `npm run db:migrate -w @omniswarm/api`.
# Secrets belong in /etc/omniswarm/*.env (root 0600) on a host, never in the repo. No secret has a default.

NODE_ENV=development                 # production refuses every test adapter below
LOG_LEVEL=info

# --- database (one Postgres for requests, nonces, rate limits and the pg-boss queue) ---
DATABASE_URL=postgres://omniswarm:omniswarm@127.0.0.1:5432/omniswarm
DATABASE_POOL_MAX=10

# --- public HTTP (API process) ---
HOST=127.0.0.1                       # 0.0.0.0 inside a container
PORT=8787
TRUST_PROXY=false                    # false | true | hop count | comma list of proxy addresses/CIDRs (nginx: 127.0.0.1)
SESSION_SECRET=                      # required, >= 32 chars (openssl rand -base64 48)
COOKIE_SECURE=                       # defaults to true when NODE_ENV=production; cannot be off in production
LANDING_ORIGIN=                      # optional: allow CORS from this origin only
RATE_LIMIT_PER_MINUTE=30             # per client IP and route, shared by all replicas
REQUESTS_PER_DAY=5                   # per account

# --- admin listener (same process, loopback only, separate port; nginx never proxies it) ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788
ADMIN_TOKEN=                         # >= 32 chars; required in production; unset = admin listener off.
                                     # Admin refunds are queued; a worker signs them (the API holds no chain key).

# --- intake rules ---
NETWORK=testnet
PRICE_YOCTO=1000000000000000000000000   # price on NETWORK; testnet defaults to 1 NEAR, mainnet stays disabled until set
INTAKE_RECIPIENT=omniswarm.testnet   # NEP-413 recipient the wallet signs for
CONTRACT_ID=review-registry.mock     # must equal the web app's NEXT_PUBLIC_CONTRACT_ID
MAX_REPO_KB=204800
MAX_QUEUE=10
ETA_MINUTES_PER_JOB=15
REPO_ALLOWLIST=                      # comma list of owner/repo or owner/*; empty = all public repos
REPO_DENYLIST=
HOSTED_PRESET=scripted               # the only preset a request may sign; with ENGINE_RUNNER=cli it must exist in
                                     # omniswarm.config.json (a real deployment uses `hosted`, OD-04), else the worker refuses to start
ALLOWED_PRESETS=                     # defaults to HOSTED_PRESET

# --- chain ---
CHAIN_ADAPTER=mock                   # mock (tests, local demo) | near; production defaults to near
RPC_URLS=                            # comma list, failover in order, e.g. FastNEAR then Lava
OPERATOR_KEY_FILE=                   # WORKER ONLY: near-cli credentials JSON or ed25519:<secret>, mode 0600; the API never loads it
OPERATOR_ACCOUNT_ID=                 # optional; defaults to the key file's account_id
MOCK_CHAIN_FAIL_RATE=0               # mock only: fraction of calls that fail with CHAIN_UNAVAILABLE

# --- GitHub ---
GITHUB_ADAPTER=recorded              # recorded (tests, local demo) | live; production defaults to live
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=                        # optional; raises the API rate limit
GITHUB_TIMEOUT_MS=5000

# --- worker and engine ---
ENGINE_RUNNER=mock                   # mock (tests, local demo) | cli (spawns $ENGINE_ROOT/bin/audit); production defaults to cli
ENGINE_ROOT=                         # defaults to the repository root
ENGINE_CONFIG=                       # defaults to $ENGINE_ROOT/omniswarm.config.json (preset -> provider keys)
ENGINE_TIMEOUT_S=5400                # below QUEUE_EXPIRE_S
ENGINE_KILL_GRACE_S=30
ENGINE_LOG_MAX_BYTES=5242880
ENGINE_ENV_PASSTHROUGH=              # extra variable names for the engine; intake secrets are refused
RUNS_ROOT=                           # host-only attempt dirs; default reports/intake/runs
REPORTS_ROOT=                        # published, read-only reports; default reports/intake/published
REPORTS_BASE_URL=https://reports.localhost   # public origin serving REPORTS_ROOT; required in production
WORKER_ID=                           # optional label of this worker instance (logs, pg-boss instance name)
WORKER_CONCURRENCY=1
WORKER_STOP_TIMEOUT_S=120
PROGRESS_POLL_MS=5000

# --- queue (applied by db:migrate) ---
QUEUE_EXPIRE_S=7200
QUEUE_HEARTBEAT_S=30
QUEUE_RETRY_LIMIT=1
QUEUE_RETRY_DELAY_S=60
QUEUE_MONITOR_S=30

# Provider keys of the hosted preset (ZAI_API_KEY, OPENROUTER_API_KEY, ...) go only in the worker's env file.
