{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniswarm.dev/schemas/intake-api.schema.json",
  "title": "intake-api",
  "description": "Request and response DTOs of every intake endpoint (INTAKE section 4). Validate one with validate('intake-api#<def>', value). Examples are named valid-<def>--<label>.json.",
  "$defs": {
    "account-id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{2,64}$"
    },
    "sha256-hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit-sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "publishing",
        "done",
        "failed"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "none"
      ]
    },
    "pipeline-mode": {
      "enum": [
        "full",
        "step-by-step",
        "stage-1"
      ]
    },
    "pipeline-summary": {
      "type": "object",
      "required": [
        "pipelineMode",
        "currentStage",
        "noDebates",
        "roundsCompleted",
        "canRunMoreRounds"
      ],
      "additionalProperties": false,
      "properties": {
        "pipelineMode": {
          "$ref": "#/$defs/pipeline-mode"
        },
        "currentStage": {
          "enum": [
            "stage-1",
            "stage-2-advice",
            "stage-3-debate",
            "completed"
          ]
        },
        "noDebates": {
          "type": "boolean"
        },
        "roundsCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "canRunMoreRounds": {
          "type": "boolean"
        },
        "advice": {
          "type": "object",
          "required": [
            "debateNeeded",
            "recommendedDepth",
            "recommendedRounds",
            "qualityRating",
            "summary"
          ],
          "additionalProperties": false,
          "properties": {
            "debateNeeded": {
              "type": "boolean"
            },
            "recommendedDepth": {
              "enum": [
                "none",
                "shallow",
                "standard",
                "deep"
              ]
            },
            "recommendedRounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "qualityRating": {
              "enum": [
                "strong",
                "adequate",
                "degraded",
                "incomplete"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "incompletionNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "category",
              "code",
              "source",
              "reason",
              "impact"
            ],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "nextStep": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "nextRoundRequestIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "error-code": {
      "enum": [
        "VALIDATION_ERROR",
        "REPO_INVALID",
        "REPO_NOT_FOUND",
        "REPO_PRIVATE",
        "REPO_ARCHIVED",
        "REPO_TOO_LARGE",
        "REPO_DENIED",
        "QUEUE_FULL",
        "NONCE_EXPIRED",
        "NONCE_USED",
        "NONCE_UNKNOWN",
        "SIG_INVALID",
        "KEY_NOT_FULL_ACCESS",
        "ACCOUNT_MISMATCH",
        "RATE_LIMITED",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "NOT_FOUND",
        "GITHUB_UNAVAILABLE",
        "INTERNAL",
        "REF_NOT_FOUND",
        "REF_CHANGED",
        "PRESET_NOT_ALLOWED",
        "PAYLOAD_TOO_LARGE",
        "INVALID_TRANSITION",
        "REQUEST_NOT_FOUND"
      ]
    },
    "error-response": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/error-code"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "challenge-request": {
      "type": "object",
      "additionalProperties": false
    },
    "challenge-response": {
      "type": "object",
      "required": [
        "nonce",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string"
        },
        "pass": {
          "type": "integer",
          "minimum": 1
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "detail": {
          "$ref": "#/$defs/progress-detail"
        }
      }
    },
    "progress-detail": {
      "description": "The engine's live snapshot (harness/host/progress.json), passed through by the worker. Counts, phase states and reviewer ids only; no finding text. A parent request split into themes carries themes instead of reviewers.",
      "type": "object",
      "required": [
        "state",
        "phases"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "running",
            "finished",
            "incomplete",
            "failed",
            "cancelled"
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "phases": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "name",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "enum": [
                  "prepare",
                  "tests",
                  "review",
                  "crosscheck",
                  "debate",
                  "adjudicate",
                  "general-review",
                  "report"
                ]
              },
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "done",
                  "failed",
                  "skipped"
                ]
              },
              "startedAt": {
                "$ref": "#/$defs/timestamp"
              },
              "endedAt": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "reviewers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "state",
              "jobsDone",
              "jobs",
              "passes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,80}$"
              },
              "state": {
                "enum": [
                  "pending",
                  "running",
                  "done",
                  "failed"
                ]
              },
              "jobsDone": {
                "type": "integer",
                "minimum": 0
              },
              "jobs": {
                "type": "integer",
                "minimum": 1
              },
              "passes": {
                "type": "integer",
                "minimum": 1
              },
              "pass": {
                "type": "integer",
                "minimum": 1
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              },
              "budget": {
                "type": "integer",
                "minimum": 1
              },
              "surface": {
                "type": "string",
                "pattern": "^S[1-6]$"
              },
              "idleMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "sessions": {
          "description": "Sessions running now that are not a reviewer's own job (cross-check, debate turns, judgements, the general review). Ids and idle time only.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "idleMs"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,120}$"
              },
              "idleMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "crosscheck": {
          "type": "object",
          "required": [
            "done",
            "total"
          ],
          "additionalProperties": false,
          "properties": {
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "debate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clusters": {
              "type": "integer",
              "minimum": 0
            },
            "heard": {
              "type": "integer",
              "minimum": 0
            },
            "judged": {
              "type": "integer",
              "minimum": 0
            },
            "toJudge": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "theme",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "theme": {
                "enum": [
                  "web3",
                  "apps",
                  "infra",
                  "scripts"
                ]
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "request-status-response": {
      "type": "object",
      "required": [
        "status",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "description": "Rank among queued requests; only while queued"
        },
        "reportUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "reportSha256": {
          "$ref": "#/$defs/sha256-hex"
        },
        "incomplete": {
          "type": "boolean",
          "description": "The report was published with report-health state incomplete"
        },
        "pipelineMode": {
          "$ref": "#/$defs/pipeline-mode"
        },
        "pipeline": {
          "$ref": "#/$defs/pipeline-summary"
        },
        "failureCause": {
          "type": "string",
          "minLength": 1
        },
        "timeline": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "event",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "progress-event": {
      "type": "object",
      "required": [
        "status",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "request-list-response": {
      "type": "object",
      "required": [
        "requests"
      ],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "requestId",
              "repo",
              "status",
              "createdAt"
            ],
            "additionalProperties": false,
            "properties": {
              "requestId": {
                "$ref": "#/$defs/uuid"
              },
              "repo": {
                "$ref": "#/$defs/repo"
              },
              "status": {
                "$ref": "#/$defs/status"
              },
              "createdAt": {
                "$ref": "#/$defs/timestamp"
              },
              "theme": {
                "type": "string",
                "minLength": 1
              },
              "progress": {
                "$ref": "#/$defs/progress",
                "description": "Latest phase and percent while running, without detail"
              }
            }
          }
        }
      }
    },
    "report-index-response": {
      "description": "GET /api/reports/:id. A published request includes reportUrl and reportSha256 (the sha256 the browser checks the report files against), the repository and the highest severity and cross-check counts from the report. Other statuses are 404.",
      "type": "object",
      "required": [
        "requestId"
      ],
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "reportUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "reportSha256": {
          "$ref": "#/$defs/sha256-hex"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generalReviewUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "stage1Url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "adviceUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "pipelineUrl": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "roundUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          }
        },
        "repo": {
          "$ref": "#/$defs/repo"
        },
        "maxSeverity": {
          "$ref": "#/$defs/severity-or-none"
        },
        "check": {
          "type": "object",
          "required": [
            "passed",
            "total"
          ],
          "additionalProperties": false,
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Findings that held up under the cross-check, and findings checked in all"
        }
      }
    },
    "health-response": {
      "type": "object",
      "required": [
        "ok",
        "queueDepth",
        "workers"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "queueDepth": {
          "type": "integer",
          "minimum": 0
        },
        "workers": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "GET /api/health: liveness plus queue status; workers counts live pg-boss worker instances."
    },
    "ready-response": {
      "type": "object",
      "required": [
        "ok",
        "db",
        "queue",
        "migrations"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "db": {
          "type": "boolean"
        },
        "queue": {
          "type": "boolean"
        },
        "migrations": {
          "type": "boolean"
        }
      }
    },
    "severity-or-none": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "none"
      ]
    }
  }
}
