# /etc/omniswarm/providers.env  (root:root 0600)
# Provider keys for the hosted preset (OD-04). Read by systemd for the worker
# units only. The API container, nginx, Postgres and the sandbox never see
# these (`npm run check:infra` fails if a compose service declares one).
# Each reviewer process receives exactly its own provider's variable from the
# engine (AGENTS.md "Key policy").
ZAI_API_KEY=
OPENROUTER_API_KEY=
